  m_EditorClassIdentifier: 
  canvasToShow: {fileID: 360681924}
  descriptionField: {fileID: 360681923}
  infoDescription: "Aunque muchas cabinas telef\xF3nicas han desaparecido y otras
    han terminado tristemente como chatarra, algunas han logrado encontrar una segunda
    vida en nuestras calles. Las Bibliocabinas son un buen ejemplo: transformadas
    en peque\xF1as bibliotecas urbanas, permiten el intercambio de libros, c\xF3mics
    y revistas, ofreciendo un nuevo uso cultural a estos iconos del paisaje urbano."
