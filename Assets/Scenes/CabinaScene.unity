  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 078bf30dfa3d40c4b839049e05ef4636, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  canvasToShow: {fileID: 360681924}
  descriptionField: {fileID: 360681923}
  infoDescription: "Jos\xE9 Luis L\xF3pez V\xE1zquez, uno de los grandes actores
    del cine espa\xF1ol, fue conocido tanto por sus papeles c\xF3micos como por sus
    interpretaciones dram\xE1ticas. En la imagen aparece justo a una cabina, como
    gui\xF1o a la ic\xF3nica pel\xEDcula \"La Cabina\" de 1972.  Su est\xE9tica sencilla
    y su carga metaf\xF3rica la convirtieron en un cl\xE1sico, muy recordado por
    su capacidad de generar angustia con elementos cotidianos."
