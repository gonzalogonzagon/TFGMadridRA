  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1f1e88d11df6f344292b3ea40744084b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  canvasToShow: {fileID: 1079910449}
  titleField: {fileID: 1079910446}
  descriptionField: {fileID: 1079910445}
  infoTitle: Villa de Madrid - Antonio Mancelli (c.a. 1623)
  infoDescription: "Plano de Madrid en perspectiva caballera. En el \xE1ngulo superior
    izquierdo se representa el escudo de Madrid. En la zona inferior tiene una leyenda
    con nombres de calles y edificios. En el \xE1ngulo inferior derecho cuenta con
    una cartela que en este ejemplar est\xE1 vac\xEDa."
