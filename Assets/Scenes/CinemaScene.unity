  m_Name: 
  m_EditorClassIdentifier: 
  canvasToShow: {fileID: 191021664}
  titleField: {fileID: 171193325}
  descriptionField: {fileID: 1901890156}
  infoTitle: Salida de misa de doce del Pilar de Zaragoza
  infoDescription: "Filmaci\xF3n, realizada a finales del siglo XIX por el aragon\xE9s
    Eduardo Jimeno, siendo una de las primeras pel\xEDculas rodadas en Espa\xF1a.
    Muestra a los feligreses saliendo de misa en la Bas\xEDlica del Pilar de Zaragoza,
    siguiendo el estilo de las primeras grabaciones de los hermanos Lumi\xE8re en
    Par\xEDs, pioneros del cine. Aunque su lugar como la primera pel\xEDcula espa\xF1ola
    ha sido objeto de debate y revisiones hist\xF3ricas, Jimeno es reconocido como
    uno de los pioneros que sentaron las bases del cine en Espa\xF1a."
